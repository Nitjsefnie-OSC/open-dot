{
  "name": "open-dot",
  "version": "0.0.0",
  "private": true,
  "description": "A durable personal agent on OpenCode V2",
  "bin": {
    "open-dot": "./src/cli.ts"
  },
  "type": "module",
  "exports": {
    ".": "./src/plugin.ts",
    "./tui": "./src/tui.ts"
  },
  "scripts": {
    "check": "vp check",
    "lint": "vp lint",
    "fmt": "vp fmt",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@opencode/client": "2.1.1",
    "@opencode/plugin": "2.1.1",
    "@opencode/theme": "2.1.1",
    "@opentui/core": "0.6.6",
    "@opentui/solid": "0.6.6",
    "drizzle-orm": "0.45.4",
    "effect": "4.0.1",
    "solid-js": "1.9.17"
  },
  "devDependencies": {
    "@types/bun": "1.4.3",
    "drizzle-kit": "0.31.11",
    "typescript": "7.0.2",
    "vite-plus": "1.3.0"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@1.3.0",
    "vitest": "5.0.5"
  },
  "packageManager": "bun@1.4.2"
}
